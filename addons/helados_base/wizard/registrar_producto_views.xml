<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helados_registrar_producto_form" model="ir.ui.view">
        <field name="name">helados.registrar.producto.form</field>
        <field name="model">helados.registrar.producto</field>
        <field name="arch" type="xml">
            <form string="Registrar producto con stock inicial">
                <group>
                    <group>
                        <field name="default_code"/>
                        <field name="name"/>
                        <field name="categ_id"/>
                    </group>
                    <group>
                        <field name="standard_price"/>
                        <field name="list_price"/>
                        <field name="cantidad_inicial"/>
                    </group>
                </group>
                <footer>
                    <button name="action_registrar" type="object" string="Guardar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_helados_registrar_producto" model="ir.actions.act_window">
        <field name="name">Registrar producto</field>
        <field name="res_model">helados.registrar.producto</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
