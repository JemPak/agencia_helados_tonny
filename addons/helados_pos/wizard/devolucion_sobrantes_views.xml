<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helados_devolucion_sobrantes_form" model="ir.ui.view">
        <field name="name">helados.devolucion.sobrantes.form</field>
        <field name="model">helados.devolucion.sobrantes</field>
        <field name="arch" type="xml">
            <form string="Devolver sobrantes a la Cava">
                <p>Cuente lo que vuelve del vehículo y escriba la cantidad en <b>Devuelto</b>.
                   Lo que falte quedará registrado como faltante de esta sesión.</p>
                <group>
                    <field name="session_id"/>
                    <field name="ubicacion_id"/>
                </group>
                <field name="linea_ids">
                    <list editable="bottom" create="false" delete="false">
                        <field name="product_id"/>
                        <field name="esperado"/>
                        <field name="devuelto"/>
                        <field name="faltante" decoration-danger="faltante &gt; 0"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirmar" type="object" string="Confirmar devolución" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
