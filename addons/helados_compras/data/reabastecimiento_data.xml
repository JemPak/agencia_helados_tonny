<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Solo al instalar: deja cada producto del catálogo listo para comprarse a
         Helados Tonny S.A.S. (proveedor con su precio de compra), carga su demanda
         mensual y crea su regla de stock mínimo/máximo en la Cava calculada con
         esa demanda (ver models/product.py). -->
    <data noupdate="1">
        <record id="param_dias_mes" model="ir.config_parameter">
            <field name="key">helados_compras.dias_mes</field>
            <field name="value">30</field>
        </record>
        <record id="param_dias_entrega" model="ir.config_parameter">
            <field name="key">helados_compras.dias_entrega</field>
            <field name="value">3</field>
        </record>
        <record id="param_dias_seguridad" model="ir.config_parameter">
            <field name="key">helados_compras.dias_seguridad</field>
            <field name="value">2</field>
        </record>
        <record id="param_dias_ciclo" model="ir.config_parameter">
            <field name="key">helados_compras.dias_ciclo</field>
            <field name="value">7</field>
        </record>

        <function model="product.template" name="_helados_configurar_compras">
            <value eval="ref('helados_compras.partner_helados_tonny')"/>
        </function>
    </data>

    <!-- Acción "Recalcular mínimos y máximos" en la lista de productos -->
    <record id="action_recalcular_reglas" model="ir.actions.server">
        <field name="name">Recalcular mínimos y máximos</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">records.action_helados_recalcular_reglas()</field>
    </record>
</odoo>
